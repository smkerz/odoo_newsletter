<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Register MC Davidian themes in the email template picker -->
    <template id="email_designer_snippets"
              inherit_id="mass_mailing.email_designer_snippets">
        <xpath expr="//div[@id='email_designer_themes']" position="inside">

            <!-- B2C - Newsletters génériques -->
            <div data-name="mcdavidian_b2c_fr"
                 title="MCD B2C FR · Newsletter"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_fr"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_template"/>
            </div>
            <div data-name="mcdavidian_b2c_en"
                 title="MCD B2C EN · Newsletter"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_en"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_en_template"/>
            </div>

            <!-- B2C - Guides produits -->
            <div data-name="mcdavidian_b2c_guide_tailles_fr"
                 title="MCD B2C FR · Guide des tailles"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_guide_tailles_fr"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_guide_tailles_fr_template"/>
            </div>
            <div data-name="mcdavidian_b2c_guide_tailles_en"
                 title="MCD B2C EN · Size Guide"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_guide_tailles_en"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_guide_tailles_en_template"/>
            </div>

            <!-- B2C - Coups de cœur + promo -->
            <div data-name="mcdavidian_b2c_nouveautes_fr"
                 title="MCD B2C FR · Coups de cœur + Promo"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_nouveautes_fr"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_nouveautes_promo_fr_template"/>
            </div>
            <div data-name="mcdavidian_b2c_nouveautes_en"
                 title="MCD B2C EN · Spring Favourites + Promo"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_nouveautes_en"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_nouveautes_promo_en_template"/>
            </div>

            <!-- B2C - Le matic / FGS -->
            <div data-name="mcdavidian_b2c_matic_fr"
                 title="MCD B2C FR · Le matic"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_matic_fr"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_matic_fr_template"/>
            </div>
            <div data-name="mcdavidian_b2c_matic_en"
                 title="MCD B2C EN · The matic"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2c_matic_en"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_matic_en_template"/>
            </div>

            <!-- B2B - Bienvenue -->
            <div data-name="mcdavidian_b2b_bienvenue"
                 title="MCD B2B · Bienvenue / Welcome"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2b_bienvenue"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_b2b_bienvenue_template"/>
            </div>

            <!-- B2B - Réassort été -->
            <div data-name="mcdavidian_b2b_reassort_ete"
                 title="MCD B2B · Réassort été / Summer reorder"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcdavidian_b2b_reassort_ete"
                 data-layout-styles="background-color: #f8f6f3 !important;">
                <t t-call="odoo_newsletter.theme_mcdavidian_b2b_reassort_ete_template"/>
            </div>

            <!-- Prospection FR - 6 segments first-touch B2B -->
            <div data-name="mcd_prospection_fr_fashion"
                 title="MCD Prospection FR · Fashion &amp; Lifestyle"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcd_prospection_fr_fashion"
                 data-layout-styles="background-color: #ffffff !important;">
                <t t-call="odoo_newsletter.theme_mcd_prospection_fr_fashion_template"/>
            </div>
            <div data-name="mcd_prospection_fr_bridal"
                 title="MCD Prospection FR · Bridal &amp; Cérémonie"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcd_prospection_fr_bridal"
                 data-layout-styles="background-color: #ffffff !important;">
                <t t-call="odoo_newsletter.theme_mcd_prospection_fr_bridal_template"/>
            </div>
            <div data-name="mcd_prospection_fr_hair_beauty"
                 title="MCD Prospection FR · Hair &amp; Beauty"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcd_prospection_fr_hair_beauty"
                 data-layout-styles="background-color: #ffffff !important;">
                <t t-call="odoo_newsletter.theme_mcd_prospection_fr_hair_beauty_template"/>
            </div>
            <div data-name="mcd_prospection_fr_wellness"
                 title="MCD Prospection FR · Wellness &amp; Hospitality"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcd_prospection_fr_wellness"
                 data-layout-styles="background-color: #ffffff !important;">
                <t t-call="odoo_newsletter.theme_mcd_prospection_fr_wellness_template"/>
            </div>
            <div data-name="mcd_prospection_fr_pharmacie"
                 title="MCD Prospection FR · Pharmacie"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcd_prospection_fr_pharmacie"
                 data-layout-styles="background-color: #ffffff !important;">
                <t t-call="odoo_newsletter.theme_mcd_prospection_fr_pharmacie_template"/>
            </div>
            <div data-name="mcd_prospection_fr_culture"
                 title="MCD Prospection FR · Culture &amp; Patrimoine"
                 data-img="/odoo_newsletter/static/src/img/theme_imgs/mcd_prospection_fr_culture"
                 data-layout-styles="background-color: #ffffff !important;">
                <t t-call="odoo_newsletter.theme_mcd_prospection_fr_culture_template"/>
            </div>

        </xpath>
    </template>

</odoo>
